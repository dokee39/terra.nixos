die() {
  printf 'init-config: %s\n' "$1" >&2
  exit 1
}

(( $# == 0 )) || die "usage: init-config"
(( EUID != 0 )) || die "must run as a normal user"

userName="$(id -un)"
hostName="$(hostname -s)"
repoDir="/etc/nixos"
configLink="$HOME/.config/nixos"

[[ "$hostName" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] ||
  die "invalid hostname: $hostName"
[[ "$userName" =~ ^[a-z_][a-z0-9_-]{0,30}$ ]] ||
  die "invalid username: $userName"
[[ ! -e "$repoDir" && ! -L "$repoDir" ]] || die "$repoDir already exists"
[[ ! -e "$configLink" && ! -L "$configLink" ]] ||
  die "$configLink already exists"

sudo -v

tmpDir="$(mktemp -d)"
trap 'rm -rf "$tmpDir"' EXIT
cloneDir="$tmpDir/nixos"

git clone https://github.com/dokee39/terra.nixos.git "$cloneDir"

hostDir="$cloneDir/hosts/$hostName"
[[ ! -e "$hostDir" ]] || die "$hostDir already exists"
mkdir "$hostDir"

cat > "$hostDir/default.nix" <<EOF
{ ... }: {
  imports = [ ./hardware.nix ];

  terra.userName = "$userName";
}
EOF

nixos-generate-config --show-hardware-config > "$hostDir/hardware.nix"
git -C "$cloneDir" add -- "hosts/$hostName"

sudo mv "$cloneDir" "$repoDir"
mkdir -p "$HOME/.config"
ln -s "$repoDir" "$configLink"

printf 'Configuration initialized at %s.\n' "$repoDir"
