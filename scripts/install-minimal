die() {
  printf 'install-minimal: %s\n' "$1" >&2
  exit 1
}

(( $# == 2 )) || die "usage: install-minimal HOSTNAME USERNAME"

hostName="$1"
userName="$2"

if (( EUID != 0 )); then
  die "must run as root"
fi

installProxy="${http_proxy:-}"
[[ -n "$installProxy" ]] || die "http_proxy is not set"

mountpoint -q /mnt || die "/mnt is not mounted"
[[ -d /sys/firmware/efi ]] || die "only UEFI systems are supported"
mountpoint -q /mnt/boot || die "/mnt/boot is not mounted"
mountpoint -q /mnt/home || die "/mnt/home is not mounted"

repoDir="/mnt/etc/nixos"
hostDir="$repoDir/hosts/$hostName"

mkdir -p /mnt/etc

printf 'Cloning repository...\n'
git clone https://github.com/dokee39/terra.nixos.git "$repoDir"

mkdir "$hostDir"
cp "$repoDir/templates/minimal.nix" "$hostDir/default.nix"
sed -i \
  -e "s/\"user_name\"/\"$userName\"/" \
  -e "s|\"install_proxy\"|\"$installProxy\"|" \
  "$hostDir/default.nix"

printf 'Generating hardware configuration...\n'
nixos-generate-config \
  --root /mnt \
  --show-hardware-config \
  > "$hostDir/hardware.nix"

git -C "$repoDir" add -- "hosts/$hostName"

printf 'Installing NixOS...\n'
nixos-install \
  --root /mnt \
  --flake "path:$repoDir#$hostName"

nixos-enter --root /mnt -c \
  "install -d -o $userName -g users /home/$userName/.config &&
   install -d -m 0700 -o $userName -g users /home/$userName/.ssh &&
   ln -s /etc/nixos /home/$userName/.config/nixos &&
   chown -R $userName:users /etc/nixos"

printf 'Generating SSH key for %s...\n' "$userName"
nixos-enter --root /mnt -c \
  "runuser -u $userName -- ssh-keygen -q -t ed25519 -N '' \
     -C $userName@$hostName \
     -f /home/$userName/.ssh/id_ed25519"

printf 'Set password for %s...\n' "$userName"
nixos-enter --root /mnt -c "passwd $userName"

printf '\nInstallation complete. Reboot, then follow /etc/nixos/README.md.\n'
