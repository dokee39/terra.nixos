select(fileIndex == 0) as $base |
select(fileIndex == 1) as $provider |
$base |
.proxies = $provider.proxies |
.dns."nameserver-policy" = ($provider.dns."nameserver-policy" // {}) |

with(.["proxy-groups"][] | select(.name == "🔰 选择节点");
  .proxies += [$provider.proxies[].name]
) |

with(.["proxy-groups"][] | select(.name == "📺 动画疯");
  .proxies += [$provider.proxies[] | select(.name | test("台湾")) | .name]
)
