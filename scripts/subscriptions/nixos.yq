.port = 7890 |
.["external-controller-unix"] = "/run/mihomo/controller.sock" |

.tun.enable = true |
.tun.device = "tun0" |
.tun.stack = "mixed" |
.tun."auto-route" = true |
.tun."auto-redirect" = true |
.tun."auto-detect-interface" = true |

.["rule-providers"]."nixos-hosts" = {
  "type": "inline",
  "behavior": "classical",
  "payload": [
    "DOMAIN-REGEX,^nixos-[^.]+$",
    "DOMAIN-SUFFIX,taila9e231.ts.net"
  ]
} |
.dns."nameserver-policy" = (
  {
    "rule-set:nixos-hosts": "100.100.100.100#tailscale-direct"
  }
  * .dns."nameserver-policy"
) |

.proxies += [
  {
    "name": "tailscale-direct",
    "type": "direct",
    "interface-name": "tailscale0"
  }
] |

.rules = (
  [
    "RULE-SET,nixos-hosts,tailscale-direct",
    "PROCESS-NAME-WILDCARD,*transmission*,DIRECT"
  ]
  + (.rules // [])
)
